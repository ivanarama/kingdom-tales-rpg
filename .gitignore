# Godot cache
.godot/

# Build artifacts (выкладываются конвейером, не хранятся в git)
builds/
*.apk
*.idsig

# Logs and junk
*.log
C:Temp*
Thumbs.db
.DS_Store

# локальные заметки агентов
AGENTS.local.md

# портативный ffmpeg для конверсии аудио (локальный инструмент)
tools/ffmpeg/

# python-кэш инструментов
tools/__pycache__/

# Скомпилированные переводы: Godot собирает их из localization/*.csv при импорте,
# как и всё в .godot/. В git они только давали бинарные конфликты в каждом PR со строками.
localization/*.translation
